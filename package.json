{
  "name": "alia",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Learning Intelligence Agent - independent adaptive-intelligence API/SDK for learning platforms.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/integration/rls tests/integration/identity tests/integration/db",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-Bimu/ALIA.git"
  },
  "bugs": {
    "url": "https://github.com/A-Bimu/ALIA/issues"
  },
  "homepage": "https://github.com/A-Bimu/ALIA#readme",
  "dependencies": {
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
