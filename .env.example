# ALIA environment template. Copy to .env for local work: cp .env.example .env
#
# Rules:
# - This file must never contain a real credential.
# - Only NEXT_PUBLIC_* values may ever reach a browser. Anything else is server-only.
# - Never expose a service-role key, provider secret, or database credential to a browser.
# - The repository ignores .env and .env.* and only tracks .env.example.

# --- Core service (safe defaults, no secret) ---
# Values: development | test | production
NODE_ENV=development
# Values: local | test | staging | production
ALIA_ENV=local
# Values: debug | info | warn | error
ALIA_LOG_LEVEL=info

# --- Browser-safe public values (must never hold a secret) ---
NEXT_PUBLIC_ALIA_SERVICE_NAME=ALIA

# --- Supabase (server-only; leave empty until ALIA-002 identity work) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Administrative background jobs only. Never used for normal tenant requests,
# never sent to a browser. Leave empty locally.
SUPABASE_SERVICE_ROLE_KEY=

# --- Token verification (server-only) ---
# Symmetric secret used to verify partner access tokens. Required by any
# authenticated route; never logged and never returned. Leave empty locally.
SUPABASE_JWT_SECRET=
# Optional: enforced only when set.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Database (server-only) ---
# Migration/owner connection string used by `npm run db:migrate` and by the local
# test harness. Include sslmode=require for a hosted database.
DATABASE_URL=
# The restricted role every normal tenant request runs as. It must not be a
# privileged role: a superuser, a service role, or an owner credential is refused.
ALIA_DB_APP_ROLE=alia_app
# Per-statement timeout for tenant request transactions, in milliseconds.
ALIA_DB_STATEMENT_TIMEOUT_MS=5000
# Set only to point the test harness at an existing database instead of starting a
# local one (CI runs the migrations against a Postgres service container this way).
# ALIA_TEST_DATABASE_URL=

# --- Model provider (server-only; ALIA-005 wires the adapter) ---
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_SMALL_NAME=llama-3.1-8b-instruct
MODEL_STRONG_NAME=llama-3.3-70b-instruct

# --- Limits (cost guardrails) ---
MODEL_REQUEST_TIMEOUT_MS=15000
MODEL_MAX_INPUT_TOKENS=4000
MODEL_MAX_OUTPUT_TOKENS=800